# Multi-LLM Configuration for 转行帮
# Copy this file to config/models.yaml and fill in your choices.

# Agents 1-3, 5: deep reasoning + interview
core:
  provider: anthropic
  model: your-model-here
  agents:
    - profile_analyzer
    - market_matcher
    - strategy_architect
    - interview_simulator

# Agent 4: text optimization
light:
  provider: openrouter
  model: your-model-here
  agents:
    - cv_optimizer
